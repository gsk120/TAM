# Local development only. Copy this file to .env; never commit .env.

# Supabase Postgres connection string. Prefer a local/dev project over production.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret

# Express API port. Vite proxies /api requests to this port during development.
PORT=8080

# Only set to true for a disposable local database when a legacy demo account is needed.
SEED_DEFAULT_USER=false
